/* pages/search/index.wxss */
.search-container {
    padding: 20rpx 30rpx;
    height: 100vh;
    background: var(--main-bg-color);
}

.search-bar {
    display: flex;
    align-items: center;
    gap: 20rpx;
    margin-bottom: 40rpx;
}

.back-icon {
    width: 40rpx;
    height: 40rpx;
}

.input-wrapper {
    flex: 1;
    height: 80rpx;
    background: #fff;
    border-radius: 40rpx;
    padding: 0 30rpx;
    display: flex;
    align-items: center;
    gap: 20rpx;
}

.search-icon {
    width: 36rpx;
    height: 36rpx;
}

.search-input {
    flex: 1;
    height: 100%;
    font-size: 28rpx;
}

.clear-icon {
    width: 36rpx;
    height: 36rpx;
}

.search-btn {
    font-size: 32rpx;
    color: #fff;
    padding: 8px 12px;
    background: rgb(36, 36, 223);
    border-radius: 6px;
}

.section {
    margin-bottom: 60rpx;
}

.section-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 18rpx;
}

.title {
    font-size: 32rpx;
    font-weight: 600;
    color: #333;
}

.delete-icon {
    width: 40rpx;
    height: 40rpx;
}

.tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 20rpx;
}

.tag {
    padding: 12rpx 24rpx;
    background: #f0f0f0;
    border-radius: 40rpx;
    font-size: 26rpx;
    border: 0.3px solid #666;
    text-align: center;
}

.history-item {
    padding: 12rpx 24rpx;
    background: #f0f0f0;
    border-radius: 40rpx;
    font-size: 26rpx;
    border: 0.3px solid #666;
    text-align: center;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 10px;
}

.close-icon {
    width: 16rpx;
    height: 16rpx;
    opacity: 0.6;
}

.result-list {
    height: calc(100vh - 160rpx);
}

.result-item {
    background: #fff;
    padding: 30rpx;
    margin-bottom: 20rpx;
    border-radius: 16rpx;
}

.result-item .title {
    display: block;
    font-size: 32rpx;
    color: #333;
    margin-bottom: 16rpx;
}

.result-item .content {
    font-size: 28rpx;
    color: #666;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
}

.empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 100rpx 0;
}

.empty-icon {
    width: 200rpx;
    height: 200rpx;
    margin-bottom: 40rpx;
}

.empty-text {
    color: #999;
    font-size: 28rpx;
}