/* pages/profile/likePosts/index.wxss */
.nav-bar {
    height: 100rpx;
    display: flex;
    align-items: center;
    padding: 0 30rpx;
    border-bottom: 1rpx solid #eee;
}

.back-icon {
    width: 40rpx;
    height: 40rpx;
    margin-right: 30rpx;
}

.title {
    font-size: 36rpx;
    font-weight: 500;
}

.post-list {
    min-height: calc(100vh - 100rpx);
    padding: 30rpx;
    box-sizing: border-box;
}

.post-item {
    background: #fff;
    border-radius: 16rpx;
    padding: 30rpx;
    margin-bottom: 30rpx;
    box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.08);
}

.post-header {
    display: flex;
    align-items: center;
    margin-bottom: 20rpx;
}

.avatar {
    width: 64rpx;
    height: 64rpx;
    border-radius: 50%;
    margin-right: 20rpx;
}

.nickname {
    font-size: 28rpx;
    color: #666;
}

.post-title {
    font-size: 32rpx;
    font-weight: 500;
    margin-bottom: 16rpx;
}

.post-content {
    font-size: 28rpx;
    color: #666;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    overflow: hidden;
    margin-bottom: 20rpx;
}

.post-footer {
    display: flex;
    gap: 40rpx;
}

.stat-item {
    display: flex;
    align-items: center;
    gap: 8rpx;
    color: #999;
}

.icon {
    width: 32rpx;
    height: 32rpx;
}

.empty {
    text-align: center;
    padding: 100rpx 0;
    color: #999;
}

.empty-icon {
    width: 200rpx;
    height: 200rpx;
    margin-bottom: 30rpx;
}

.post-item {
    background: #fff;
    border-radius: 16px;
    margin-bottom: 28px;
    padding: 30rpx;
    box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.05);
    border: 0.5px solid black;
}

.post-header {
    display: flex;
    align-items: center;
    gap: 12px;
    justify-content: space-between;
}

.post-avatar {
    border-radius: 50%;
    width: 36px;
    height: 36px;
}

.post-nickname {
    color: #666;
    letter-spacing: 0.5px;
    font-size: 17px;
}

.post-detail-btn {
    width: 80px !important;
    height: 32px !important;
    display: flex;
    align-items: center;
    font-size: 16px;
    font-weight: 400;
    z-index: 100;
}

.post-body {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-bottom: 30px;
}

.post-content {
    display: -webkit-box;
    -webkit-line-clamp: 3; 
    -webkit-box-orient: vertical;
    overflow: hidden;
    line-height: 1.5;
    font-size: 15px;
}

.post-image {
    height: 160px;
}

.post-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.post-view {
    width: 100px;
}

.post-btn-group {
    display: flex;
    flex: 1;
}

.view-btn {
    width: 100px !important;
    height: 30px !important;
    background: rgb(49, 49, 216);
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 18px;
    color: white;
    font-weight: 400;
    z-index: 100;
}

.view-btn-icon {
    width: 20px !important; 
    height: 20px !important;
}