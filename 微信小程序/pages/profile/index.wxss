/* pages/profile/index.wxss */
.container {
    padding: 40rpx;
    background: var(--main-bg-color);
    min-height: 100vh;
}

.profile-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-top: 80rpx;
}

.avatar-section {
    position: relative;
    width: 200rpx;
    height: 200rpx;
    margin-bottom: 40rpx;
}

.avatar {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    border: 4rpx solid #fff;
    box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.1);
}

.edit-overlay {
    position: absolute;
    bottom: 0;
    right: 0;
    width: 60rpx;
    height: 60rpx;
    background: #07c160;
    border-radius: 50%;
    display: flex;
    justify-content: center;
    align-items: center;
    border: 4rpx solid #fff;
}

.edit-icon {
    width: 32rpx;
    height: 32rpx;
}

.profile-body {
    margin-top: 60rpx;
    padding: 0 30rpx;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 18px;
    overflow-y: hidden;
}

.record-section {
    flex: 1;
    background: #fff;
    display: flex;
    justify-content: center;
    align-items: center;
    flex-direction: column;
    border-radius: 8px;
    padding: 8px 12px;
    box-sizing: border-box;
    gap: 6px;
    box-shadow: 2px 0px 4px 1px rgba(0, 0, 0, 0.12);
}

.section-icon {
    width: 40rpx;
    height: 40rpx;
}

.section-title {
    font-size: 14px;
    letter-spacing: 0.5px;
    font-weight: 500;
    color: #333;
    flex-wrap: nowrap;
}

.post-list {
    white-space: nowrap;
    width: 100%;
}

.post-item {
    display: inline-block;
    width: 240rpx;
    margin-right: 20rpx;
    vertical-align: top;
}

.post-image {
    width: 240rpx;
    height: 240rpx;
    border-radius: 12rpx;
    background: #f5f5f5;
}

.post-title {
    display: block;
    font-size: 26rpx;
    color: #666;
    margin-top: 16rpx;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.empty {
    font-size: 28rpx;
    color: #999;
    padding: 30rpx 0;
    text-align: center;
}

.nickname-section {
    display: flex;
    align-items: center;
    gap: 20rpx;
}

.nickname {
    font-size: 36rpx;
    font-weight: 500;
    color: #333;
    max-width: 400rpx;
    overflow: hidden;
    text-overflow: ellipsis;
}

.logout-section {
    position: fixed;
    bottom: 80rpx;
    left: 0;
    right: 0;
    padding: 0 40rpx;
}

.logout-btn {
    width: 100%;
    height: 96rpx;
    line-height: 96rpx;
    background: #fff;
    color: #ff4444;
    font-size: 32rpx;
    border-radius: 48rpx;
    box-shadow: 0 8rpx 24rpx rgba(255,68,68,0.1);
    transition: all 0.2s ease;
    display: flex;
    justify-content: center;
    align-items: center;
}

.logout-btn:active {
    opacity: 0.8;
    transform: scale(0.98);
}