/* pages/community/topic/index.wxss */
.container {
    min-height: 100vh;
    background: var(--main-bg-color);
}
  
.add-post-btn {
    position: fixed;
    right: 40rpx;
    bottom: 120rpx !important;
    width: 100rpx !important;
    height: 100rpx !important;
    background: #07c160;
    color: #fff;
    border-radius: 50%;
    display: flex;
    justify-content: center;
    align-items: center;
    font-size: 80rpx;
    box-shadow: 0 8rpx 24rpx rgba(7,193,96,0.3);
    transition: all 0.3s ease;
    z-index: 1000;
    font-family: '黑体';
}
  
.add-post-btn.hide {
    transform: translateY(120%);
    opacity: 0;
}
  
/* 遮罩层 */
.mask {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0,0,0,0.5);
    opacity: 0;
    transition: opacity 0.3s ease;
    z-index: 90;
}
  
.mask.show {
    opacity: 1;
}
  
.edit-popup {
    position: fixed;
    bottom: -100vh;
    left: 0;
    right: 0;
    height: 80vh;
    background: #fff;
    border-radius: 32rpx 32rpx 0 0;
    padding: 32rpx;
    box-sizing: border-box;
    transition: transform 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    z-index: 1000;
}
  
.edit-popup.active {
    transform: translateY(-100vh);
}
  
.popup-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 40rpx;
}
  
.popup-header .title {
    font-size: 36rpx;
    font-weight: 600;
}
  
.close-icon {
    width: 36rpx;
    height: 36rpx;
}
  
.form-item {
    margin-bottom: 40rpx;
}
  
.label {
    display: block;
    font-size: 28rpx;
    color: black;
    margin-bottom: 20rpx;
}
  
.input {
    height: 80rpx;
    background: #f8f8f8;
    border-radius: 12rpx;
    padding: 0 20rpx;
}
  
.textarea {
    height: 200rpx;
    background: #f8f8f8;
    border-radius: 12rpx;
    padding: 20rpx;
}
  
.image-picker {
    display: flex;
    flex-wrap: wrap;
    gap: 20rpx;
}
  
.image-item {
    width: 200rpx;
    height: 200rpx;
    border-radius: 12rpx;
    position: relative;
}
  
.image-item .image {
    width: 100%;
    height: 100%;
}
  
.delete-icon {
    position: absolute;
    right: -16rpx;
    top: -16rpx;
    width: 48rpx;
    height: 48rpx;
}
  
.add-image {
    width: 200rpx;
    height: 200rpx;
    background: #f8f8f8;
    border-radius: 12rpx;
    display: flex;
    justify-content: center;
    align-items: center;
}
  
.add-icon {
    width: 36%;
    height: 36%;
}
  
.popup-footer {
    display: flex;
    justify-content: flex-end;
    gap: 30rpx;
    margin-top: 60rpx;
}
  
.btn {
    width: 200rpx;
    height: 80rpx;
    line-height: 80rpx;
    border-radius: 40rpx;
    font-size: 28rpx;
    transition: all 0.2s ease;
    display: flex !important;
    justify-content: center !important;
    align-items: center !important;
}
  
.btn.cancel {
    background: #f0f0f0;
    color: #666;
}
  
.btn.submit {
    background: #07c160;
    color: #fff;
}
  
.btn:active {
    opacity: 0.8;
    transform: scale(0.95);
}

.post-list {
    padding: 20px;
}

.post-item {
    background: #fff;
    border-radius: 16px;
    margin-bottom: 28px;
    padding: 30rpx;
    box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.05);
    border: 0.5px solid black;
}

.post-header {
    display: flex;
    align-items: center;
    gap: 12px;
    justify-content: space-between;
}

.post-avatar {
    border-radius: 50%;
    width: 36px;
    height: 36px;
}

.post-nickname {
    color: #666;
    letter-spacing: 0.5px;
    font-size: 17px;
}

.post-detail-btn {
    width: 80px !important;
    height: 32px !important;
    display: flex;
    align-items: center;
    font-size: 16px;
    font-weight: 400;
    z-index: 100;
}

.post-body {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-bottom: 30px;
}

.post-content {
    display: -webkit-box;
    -webkit-line-clamp: 3; 
    -webkit-box-orient: vertical;
    overflow: hidden;
    line-height: 1.5;
    font-size: 15px;
}

.post-image {
    height: 160px;
}

.post-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.post-view {
    width: 100px;
}

.post-btn-group {
    display: flex;
    flex: 1;
}

.view-btn {
    width: 100px !important;
    height: 30px !important;
    background: rgb(49, 49, 216);
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 18px;
    color: white;
    font-weight: 400;
    z-index: 100;
}

.view-btn-icon {
    width: 20px !important; 
    height: 20px !important;
}